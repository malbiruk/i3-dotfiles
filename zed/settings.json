// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
  "use_system_window_tabs": false,
  "language_models": {
    "openai_compatible": {
      "Modal": {
        "api_url": "https://ansficp--qwen-coder-vllm-serve.modal.run/v1",
        "available_models": [
          {
            "name": "qwen3-14b-awq",
            "display_name": null,
            "max_tokens": 32768,
            "max_output_tokens": 8192,
            "max_completion_tokens": 8192,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
            },
          },
        ],
      },
    },
  },
  "ssh_connections": [
    {
      "host": "kostiuki.duckdns.org",
      "username": "family",
      "port": 2222,
      "args": [],
      "projects": [],
    },
    {
      "host": "whitesnake",
      "args": [],
      "projects": [
        {
          "paths": ["/home/klim/tatd"],
        },
      ],
      "port_forwards": [
        {
          "local_port": 8899,
          "remote_port": 8899,
        },
      ],
    },
  ],
  // "proxy": "socks5h://localhost:1080",
  "bottom_dock_layout": "left_aligned",
  "show_edit_predictions": true,
  "features": {
    "edit_prediction_provider": "zed",
  },
  "edit_predictions": {
    "mode": "subtle",
    "enabled_in_text_threads": false,
  },
  "auto_update": true,
  "agent_ui_font_size": 16,
  "agent": {
    "single_file_review": false,
    "use_modifier_to_send": true,
    "default_profile": "write",
    "always_allow_tool_actions": false,
    "default_view": "text_thread",
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-pro",
    },
    "dock": "right",
  },
  "restore_on_startup": "last_workspace",
  "project_panel": {
    "auto_fold_dirs": true,
  },
  "collaboration_panel": {
    "button": false,
  },
  "notification_panel": {
    "button": false,
  },
  "inline_code_actions": false,
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "title_bar": {
    "show_user_picture": false,
  },
  "centered_layout": {
    "left_padding": 0.08,
    "right_padding": 0.08,
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "inlay_hints": {
    "enabled": false,
    "toggle_on_modifiers_press": {
      "alt": true,
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
      "delay_ms": 1000,
      "min_column": 80,
    },
  },
  "vim_mode": false,
  "relative_line_numbers": "disabled",
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "cursor_blink": true,
  "buffer_font_family": "Monaco",
  "ui_font_size": 14,
  "buffer_font_size": 13.5,
  "buffer_line_height": "comfortable",
  "soft_wrap": "editor_width",
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "base_keymap": "Atom",
  "theme": "Everforest Dark Hard",
  "terminal": {
    "dock": "right",
    "blinking": "on",
    "copy_on_select": true,
    "detect_venv": "off",
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/dist",
    "**/.vscode",
  ],
  "remove_trailing_whitespace_on_save": true,
  "always_treat_brackets_as_autoclosed": true,
  "file_types": {
    "Swift": ["scd"],
  },
  "languages": {
    "Python": {
      "language_servers": [
        "!basedpyright",
        "pyright", // language server, import checks
        "!pylsp",
        "ruff", // linting and formatting
      ],
      "preferred_line_length": 100,
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "Swift": {
      "language_servers": ["!sourcekit-lsp"],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
    "pylsp": {
      "settings": {
        "plugins": {
          "ruff": {
            "enabled": false,
          },
          "pyflakes": {
            "enabled": false,
          },
          "mypy": {
            "enabled": false,
          },
          "pycodestyle": {
            "enabled": false,
          },
        },
      },
    },
    "pyright": {
      "settings": {
        "pyright": {
          "disableLanguageServices": false,
        },
        "python": {
          "pythonPath": ".venv/bin/python",
        },
        "python.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "off",
          "diagnosticSeverityOverrides": {
            "reportUnusedExpression": "none",
            "reportCallIssue": "none",
            "reportAttributeAccessIssue": "information",
            "reportMissingImports": "none",
            "reportUnknownArgumentType": "none",
            "reportMissingModuleSource": "information",
            "reportInvalidTypeForm": "none",
            "reportUndefinedVariable": "none",
          },
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "exclude": ["**/tests/**"],
          "path": "./pyproject.toml",
          "lineLength": 100,
          "targetVersion": "py311",
          "lint": {
            // "select": ["E", "F", "I"],
            "select": ["ALL"],
            "fixable": ["ALL"],
            "ignore": [
              // "PT", // pytest-related rules
              "DTZ007", // Naive datetime.strptime -- without tz
              "ERA", // eradicate commented-out code detection
              "RUF001", // confusing characters
              "PD101", // Using series.nunique() for checking that a series is constant is inefficient
              // "TD", // todo comments detection
              "T201", // flake8-print rules (print statements)
              // "S", // flake8-bandit security rules
              // "S101", // Use of assert detected
              "S301", // use of pickle
              "S311", // cryptographic pseudo-randomness warning
              "S603", // Check for method calls that initiate a subprocess without a shell
              "S607", // partial path in subprocess
              "S608", // Possible SQL injection vector through string-based query construction
              "ANN", // flake8-annotations type annotation rules
              "D", // pydocstyle docstring rules
              "E501", // line too long
              "INP", // flake8-no-pep420 rules (implicit namespace packages)
              "PLR2004", // Magic value used in comparison
              "B905", // `zip()` without an explicit `strict=` parameter
              "PLR0913", // Too many arguments to function call
              "C408", // Unnecessary `dict` call (rewrite as a literal)
              // "I001", // Import block is un-sorted or un-formatted
              // "DTZ005", // datetime.datetime.now() called without a tz argument
              // "PLW1510", // subprocess run without check
              "PD901", // Avoid using the generic variable name df for DataFrames
              "NPY002", // Replace legacy np.random.{method_name} call with np.random.Generator
              "TRY003", // Avoid specifying long messages outside the exception class
              "TRY400", // Use logger.exception instead of logger.error
              "G004", // f-strings in logs
              // "FLY002", // Consider {expression} instead of string join
              // "PLE1142", // await should be used within an async function
              "EXE001", // Shebang is present but file is not executable
              "EM101", // Exception must not use a string literal, assign to variable first
              "EM102", // Exception must not use an f-string literal, assign to variable first
              "NPY201", // np.{existing} will be removed in NumPy 2.0. {migration_guide}
              "BLE001", // Do not catch blind exception: `Exception`
              "FA102", // from __future__ import annotations
            ],
          },
        },
      },
    },
  },
}
